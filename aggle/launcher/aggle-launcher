#!/usr/bin/env python3
"""
Aggle Browser Launcher
Sets up the Aggle profile, installs the extension, and launches Aggle.
"""

import os
import re
import sys
import json
import shutil
import subprocess
import time
import uuid
import zipfile
from pathlib import Path
from typing import Tuple, Optional

# ─── Paths ───────────────────────────────────────────────────────────────────

HOME = Path.home()
AGGLE_DIR = HOME / "Library" / "Application Support" / "Aggle"
PROFILE_DIR = AGGLE_DIR / "Profiles" / "default"
CHROME_DIR = PROFILE_DIR / "chrome"
EXTENSIONS_DIR = PROFILE_DIR / "extensions"
TEMP_DIR = AGGLE_DIR / "_temp"

# Where this script lives inside the .app bundle
APP_ROOT = Path(__file__).parent.parent
RESOURCES = APP_ROOT / "Resources"
CHROME_SRC = RESOURCES / "chrome"
EXTENSION_XPI = RESOURCES / "aggle-extension.xpi"

# LibreWolf application (Aggle is a profile/theme on top of it)
LIBREWOLF_APP = Path("/Applications/LibreWolf.app")
AGGLE_APP = LIBREWOLF_APP  # fallback alias for backward compat


# ─── Setup ───────────────────────────────────────────────────────────────────

def log(msg: str) -> None:
    print(f"[Aggle] {msg}", file=sys.stderr)


def setup_profile() -> None:
    """Create/verify the Aggle user profile."""
    log("Setting up profile...")
    PROFILE_DIR.mkdir(parents=True, exist_ok=True)
    CHROME_DIR.mkdir(exist_ok=True)
    EXTENSIONS_DIR.mkdir(exist_ok=True)
    TEMP_DIR.mkdir(exist_ok=True)

    # Copy chrome stylesheets
    for css_file in ("userChrome.css", "userContent.css"):
        src = CHROME_SRC / css_file
        dst = CHROME_DIR / css_file
        if src.exists():
            needs_update = True
            if dst.exists():
                with open(src, "rb") as sf, open(dst, "rb") as df:
                    if sf.read() == df.read():
                        needs_update = False
            
            if needs_update:
                shutil.copy(src, dst)  # use copy instead of copy2 to update mtime
                log(f"Updated {css_file}")
                
                # Clear startupCache so Firefox picks up the new CSS immediately
                # Firefox stores this in the local cache dir, which on macOS is in ~/Library/Caches
                for cache_base in (HOME / "Library" / "Caches" / "LibreWolf", HOME / "Library" / "Caches" / "Aggle"):
                    if cache_base.exists():
                        for profile_dir in cache_base.glob("Profiles/*"):
                            sc = profile_dir / "startupCache"
                            if sc.exists():
                                shutil.rmtree(sc, ignore_errors=True)
                                log(f"Cleared startupCache in {profile_dir.name}")
    # Write user.js preferences
    userjs = PROFILE_DIR / "user.js"
    userjs.write_text(_generate_userjs())
    log("Wrote user.js")

    # Install extension
    if EXTENSION_XPI.exists():
        install_extension(EXTENSION_XPI)
    else:
        log("Warning: aggle-extension.xpi not found — extension won't be installed")


def install_extension(xpi_path: Path) -> None:
    """Install the Aggle extension into the profile.

    Modern Firefox no longer side-loads XPIs dropped into the extensions
    folder, and policy install URLs must be https — so we place the packed
    XPI and register it directly in the profile's extension database.
    """
    dest = EXTENSIONS_DIR / "aggle@aggle.dev.xpi"
    shutil.copy2(xpi_path, dest)

    # Clean up any unpacked folder from the old (broken) approach
    old_dir = EXTENSIONS_DIR / "aggle@aggle.dev"
    if old_dir.exists():
        shutil.rmtree(old_dir)

    _register_extension_db(dest)
    log("Installed extension: aggle@aggle.dev (registered in extension DB)")


def _register_extension_db(xpi_path: Path) -> None:
    """Add the Aggle addon entry to <profile>/extensions.json.

    The schema mirrors what this engine writes for a working install
    (verified against a policy-installed addon on the same version).
    """
    now = int(time.time() * 1000)
    version = "1.1.0"
    try:
        with zipfile.ZipFile(xpi_path, "r") as zf:
            if "manifest.json" in zf.namelist():
                mf = json.loads(zf.read("manifest.json").decode("utf-8"))
                version = mf.get("version", version)
    except Exception:
        pass
    entry = {
        "id": "aggle@aggle.dev",
        "syncGUID": "{%s}" % uuid.uuid4(),
        "version": version,
        "type": "extension",
        "loader": None,
        "updateURL": None,
        "installOrigins": None,
        "manifestVersion": 2,
        "optionsURL": "src/options/options.html",
        "optionsType": 3,
        "optionsBrowserStyle": False,
        "aboutURL": None,
        "defaultLocale": {
            "name": "Aggle",
            "description": "Aggle — premium privacy browser layer",
            "creator": None, "developers": None,
            "translators": None, "contributors": None,
        },
        "visible": True,
        "active": True,
        "userDisabled": False,
        "appDisabled": False,
        "embedderDisabled": False,
        "installDate": now,
        "updateDate": now,
        "applyBackgroundUpdates": 1,
        "path": str(xpi_path),
        "skinnable": False,
        "sourceURI": None,
        "releaseNotesURI": None,
        "softDisabled": False,
        "foreignInstall": False,
        "strictCompatibility": True,
        "locales": [],
        "targetApplications": [
            {"id": "toolkit@mozilla.org", "minVersion": "115.0", "maxVersion": None}
        ],
        "targetPlatforms": [],
        "signedState": 0,
        "signedTypes": None,
        "signedDate": 0,
        "seen": True,
        "dependencies": [],
        "incognito": "spanning",
        "userPermissions": {
            "permissions": ["tabs", "storage", "webRequest", "webRequestBlocking",
                            "browsingData", "privacy", "activeTab", "clipboardWrite"],
            "origins": ["<all_urls>"],
            "data_collection": ["none"],
        },
        "optionalPermissions": {"permissions": [], "origins": [], "data_collection": []},
        "requestedPermissions": {"permissions": [], "origins": [], "data_collection": []},
        "icons": {"48": "public/icons/aggle-icon.svg", "96": "public/icons/aggle-icon.svg"},
        "iconURL": None,
        "blocklistAttentionDismissed": False,
        "blocklistState": 0,
        "blocklistURL": None,
        "startupData": None,
        "hidden": False,
        "installTelemetryInfo": None,
        "recommendationState": None,
        "rootURI": "jar:file://%s!/" % xpi_path,
        "location": "app-profile",
    }

    db_path = PROFILE_DIR / "extensions.json"
    db = {"addons": [], "schemaVersion": 31}
    if db_path.exists():
        try:
            db = json.loads(db_path.read_text())
        except (ValueError, OSError):
            pass
    db.setdefault("addons", [])
    db["addons"] = [a for a in db["addons"] if a.get("id") != "aggle@aggle.dev"]
    db["addons"].append(entry)
    db_path.write_text(json.dumps(db, indent=1))


def _extension_newtab_url() -> Optional[str]:
    """Resolve the Aggle extension's newtab URL from the profile's prefs.js.

    The engine maps each extension to a moz-extension://<uuid> origin and
    stores the mapping in the "extensions.webextensions.uuids" pref. On this
    engine build, raw about:newtab loads are served the built-in Activity
    Stream even when an extension overrides the newtab (the override only
    affects the toolbar new-tab action), so the startup homepage must point
    at the extension page directly. Returns None until the engine has run
    once and assigned the UUID.
    """
    prefs = PROFILE_DIR / "prefs.js"
    if not prefs.exists():
        return None
    try:
        m = re.search(
            r'aggle@aggle\.dev\\?"\s*:\s*\\?"([0-9a-f-]{36})', prefs.read_text()
        )
    except OSError:
        return None
    if not m:
        return None
    return f"moz-extension://{m.group(1)}/src/newtab/newtab.html"


def _generate_userjs() -> str:
    """Generate user.js with Aggle + Aggle preferences."""
    homepage = _extension_newtab_url() or "about:newtab"
    return f"""\
