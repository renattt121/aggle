"""


# ─── CLI ──────────────────────────────────────────────────────────────────────

def parse_args() -> Tuple[list, Optional[Path]]:
    """Parse CLI arguments. Returns (remaining_args, app_path_override)."""
    app_path = None
    dry_run = False
    remaining = []
    for arg in sys.argv[1:]:
        if arg.startswith("--app="):
            app_path = Path(arg[len("--app="):])
        elif arg == "--dry-run":
            dry_run = True
        else:
            remaining.append(arg)
    return remaining, app_path, dry_run


# ─── Launch ──────────────────────────────────────────────────────────────────

def launch(app_path: Optional[Path] = None, dry_run: bool = False,
           extra_args: Optional[list] = None) -> None:
    """Launch Aggle with the Aggle profile.

    Prefers the browser engine bundled inside this .app bundle; falls back
    to a system LibreWolf install.
    """
    target_app = app_path or AGGLE_APP
    bundled_bin = APP_ROOT / "MacOS" / "aggle"
    if not bundled_bin.exists():
        bundled_bin = APP_ROOT / "MacOS" / "librewolf"

    if dry_run:
        setup_profile()
        if bundled_bin.exists():
            log(f"Dry-run: would launch bundled engine at {bundled_bin}")
            return
        log(f"Dry-run: would launch {target_app}")
        if not target_app.exists():
            log(f"Error: App not found at {target_app}")
            sys.exit(1)
        return

    log("Launching Aggle...")

    # Launch the splash screen concurrently
    splash_bin = APP_ROOT / "MacOS" / "aggle-splash"
    if splash_bin.exists():
        splash_proc = subprocess.Popen([str(splash_bin)])
        
        # Fork a monitor to kill the splash screen at exactly 2 seconds
        monitor_pid = os.fork()
        if monitor_pid == 0:
            time.sleep(2.0)
            if splash_proc.poll() is None:
                splash_proc.terminate()
            os._exit(0)
            
        # Delay browser launch until 2.3 seconds have passed
        time.sleep(2.3)

    # Preferred: engine bundled inside this .app
    if bundled_bin.exists():
        setup_profile()
        args = [str(bundled_bin), "--profile", str(PROFILE_DIR)] + list(extra_args or [])
        log(f"Running bundled engine (profile: {PROFILE_DIR})")
        os.execv(args[0], args)  # replaces this process; never returns

    # Fallback: system LibreWolf
    if not target_app.exists():
        log(f"Error: {target_app.name} not found at {target_app}")
        log("Please install LibreWolf first: https://librewolf.net")
        sys.exit(1)

    setup_profile()
    args = [
        "open",
        "-a", str(target_app),
        "--args",
        "--profile", str(PROFILE_DIR),
    ] + list(extra_args or [])
    log(f"Running: {' '.join(args)}")
    result = subprocess.run(args)
    sys.exit(result.returncode)


# ─── Main ────────────────────────────────────────────────────────────────────

USAGE = """Usage: aggle-launcher [--dry-run] [--app=PATH] [BROWSER_ARGS...]

Options:
  --dry-run       Verify setup without launching the browser
  --app=PATH      Browser .app bundle to use (fallback when no bundled engine)
  -h, --help      Show this help

Any other arguments are passed through to the browser engine.
"""

if __name__ == "__main__":
    if "-h" in sys.argv[1:] or "--help" in sys.argv[1:]:
        print(USAGE, end="")
        sys.exit(0)
    remaining, app_path, dry_run = parse_args()
    launch(app_path=app_path, dry_run=dry_run, extra_args=remaining)
