{
  "manifest_version": 2,
  "name": "Aggle",
  "version": "0.1.0",
  "description": "Aggle browser layer",
  "permissions": ["tabs", "storage", "webRequest", "webRequestBlocking", "<all_urls>", "browsingData", "privacy"],
  "background": { "scripts": ["dist/background.js"], "persistent": true },
  "browser_action": { "default_icon": "public/icons/aggle-32.png", "default_title": "Aggle" },
  "sidebar_action": { "default_icon": "public/icons/aggle-32.png", "default_title": "Aggle AI", "default_panel": "src/sidebar/panel.html" },
  "options_ui": { "page": "src/options/options.html", "open_in_tab": true },
  "icons": { "48": "public/icons/aggle-48.png", "96": "public/icons/aggle-96.png" },
  "commands": {
    "open-stats": { "suggested_key": { "default": "Ctrl+Shift+U", "mac": "Command+Shift+U" }, "description": "Open Aggle Stats" },
    "toggle-ai-sidebar": { "suggested_key": { "default": "Ctrl+J", "mac": "Command+J" }, "description": "Toggle AI sidebar" }
  }
}