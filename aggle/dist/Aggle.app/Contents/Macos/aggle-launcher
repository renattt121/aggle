#!/usr/bin/env python3
"""
Aggle Browser Launcher
Sets up the Aggle profile, installs the extension, and launches Aggle.
"""

import os
import sys
import json
import shutil
import subprocess
import zipfile
from pathlib import Path

# ─── Paths ───────────────────────────────────────────────────────────────────

HOME = Path.home()
AGGLE_DIR = HOME / "Library" / "Application Support" / "Aggle"
PROFILE_DIR = AGGLE_DIR / "Profiles" / "default"
CHROME_DIR = PROFILE_DIR / "chrome"
EXTENSIONS_DIR = PROFILE_DIR / "extensions"
TEMP_DIR = AGGLE_DIR / "_temp"

# Where this script lives inside the .app bundle
APP_ROOT = Path(__file__).parent.parent
RESOURCES = APP_ROOT / "Resources"
CHROME_SRC = RESOURCES / "chrome"
EXTENSION_XPI = RESOURCES / "aggle-extension.xpi"

# Aggle application
LIBREWOLF_APP = Path("/Applications/Aggle.app")


# ─── Setup ───────────────────────────────────────────────────────────────────

def log(msg: str) -> None:
    print(f"[Aggle] {msg}", file=sys.stderr)


def setup_profile() -> None:
    """Create/verify the Aggle user profile."""
    log("Setting up profile...")
    PROFILE_DIR.mkdir(parents=True, exist_ok=True)
    CHROME_DIR.mkdir(exist_ok=True)
    EXTENSIONS_DIR.mkdir(exist_ok=True)
    TEMP_DIR.mkdir(exist_ok=True)

    # Copy chrome stylesheets
    for css_file in ("userChrome.css", "userContent.css"):
        src = CHROME_SRC / css_file
        dst = CHROME_DIR / css_file
        if src.exists():
            shutil.copy2(src, dst)
            log(f"Copied {css_file}")

    # Write user.js preferences
    userjs = PROFILE_DIR / "user.js"
    userjs.write_text(_generate_userjs())
    log("Wrote user.js")

    # Install extension
    if EXTENSION_XPI.exists():
        install_extension(EXTENSION_XPI)
    else:
        log("Warning: aggle-extension.xpi not found — extension won't be installed")


def install_extension(xpi_path: Path) -> None:
    """Extract XPI and copy to extensions folder."""
    ext_id = "aggle@aggle.dev"
    ext_dir = EXTENSIONS_DIR / ext_id

    # Remove old install if present
    if ext_dir.exists():
        shutil.rmtree(ext_dir)

    # Extract XPI
    with zipfile.ZipFile(xpi_path, "r") as zf:
        zf.extractall(TEMP_DIR)

    # Copy everything except node_modules
    for item in TEMP_DIR.iterdir():
        dest = ext_dir / item.name
        if item.is_dir():
            shutil.copytree(item, dest, dirs_exist_ok=True)
        else:
            shutil.copy2(item, dest)

    # Clean up temp
    shutil.rmtree(TEMP_DIR, ignore_errors=True)
    log(f"Installed extension: {ext_id}")


def _generate_userjs() -> str:
    """Generate user.js with Aggle + Aggle preferences."""
    return """\
// Aggle Browser — User Preferences
// Generated by aggle-launcher

// Enable user Chrome stylesheets
user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);

// Privacy — Aggle defaults
user_pref("privacy.trackingprotection.enabled", true);
user_pref("privacy.trackingprotection.pbmode.enabled", true);
user_pref("privacy.resistFingerprinting", false);
user_pref("privacy.sanitize.sanitizeOnShutdown", false);

// Performance
user_pref("dom.ipc.processCount", 8);
user_pref("browser.cache.disk.capacity", 512000);
user_pref("browser.cache.disk.enable", true);
user_pref("media.hardware-video-decoding.enabled", true);
user_pref("gfx.webrender.all", true);

// UI — Aggle chrome
user_pref("browser.tabs.drawInTitlebar", false);
user_pref("browser.tabs.height", 36);
user_pref("browser.chrome.site_icons", true);
user_pref("browser.newtabpage.enabled", true);
user_pref("browser.startup.homepage", "about:blank");

// Disable telemetry
user_pref("browser.ping-centre.telemetry", false);
user_pref("toolkit.telemetry.unified", false);
user_pref("toolkit.telemetry.enabled", false);
user_pref("toolkit.telemetry.server", "");
user_pref("datareporting.healthreport.uploadEnabled", false);
user_pref("datareporting.policy.dataSubmissionEnabled", false);
"""


# ─── Launch ──────────────────────────────────────────────────────────────────

def launch() -> None:
    """Launch Aggle with the Aggle profile."""
    log("Launching Aggle...")

    # Verify Aggle is installed
    if not LIBREWOLF_APP.exists():
        log(f"Error: Aggle not found at {LIBREWOLF_APP}")
        log("Please install Aggle first: https://Aggle.net")
        sys.exit(1)

    # Setup profile
    setup_profile()

    # Launch with profile
    args = [
        "open",
        "-a", str(LIBREWOLF_APP),
        "--args",
        "--profile", str(PROFILE_DIR),
    ]
    log(f"Running: {' '.join(args)}")
    result = subprocess.run(args)
    sys.exit(result.returncode)


# ─── Main ────────────────────────────────────────────────────────────────────

if __name__ == "__main__":
    launch()
